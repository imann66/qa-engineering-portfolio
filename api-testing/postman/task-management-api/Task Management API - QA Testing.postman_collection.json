              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Task can be retrieved\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Retrieved task ID is correct\", function () {\r\n    pm.expect(response.id).to.eql(\r\n        Number(pm.collectionVariables.get(\"taskId\"))\r\n    );\r\n});\r\n\r\npm.test(\"Task title is correct\", function () {\r\n    pm.expect(response.title).to.eql(\"E2E QA Test Task\");\r\n});"
                ]
