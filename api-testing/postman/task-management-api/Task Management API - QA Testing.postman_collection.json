      "name": "End-to-End CRUD Workflow",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Task is created successfully\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Response contains a task ID\", function () {\r\n    pm.expect(response.id).to.exist;\r\n});\r\n\r\npm.test(\"Task has the correct initial status\", function () {\r\n    pm.expect(response.status).to.eql(\"pending\");\r\n});\r\n\r\npm.collectionVariables.set(\"taskId\", response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"E2E QA Test Task\",\n    \"description\": \"Testing the complete task lifecycle\",\n    \"status\": \"pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            }
          },
          "response": []
